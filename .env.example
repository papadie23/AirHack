# Orange API credentials (server-side only — NEVER expose to the browser)
ORANGE_CLIENT_ID=your_client_id_here
ORANGE_CLIENT_SECRET=your_client_secret_here

# Set to "false" to use live Orange Playground APIs instead of local fixtures.
# Defaults to "true" (fixture mode) so the demo works without credentials.
USE_FIXTURES=true

# METAR providers (optional — without keys these fall back to fixture data)
# CheckWX: https://www.checkwx.com/api
CHECKWX_API_KEY=your_checkwx_api_key_here

# Weather providers (optional — without keys these return 503 with a hint)
# Meteoblue: https://www.meteoblue.com/en/weather-api
METEOBLUE_API_KEY=your_meteoblue_api_key_here
# AccuWeather: https://developer.accuweather.com
ACCUWEATHER_API_KEY=your_accuweather_api_key_here
