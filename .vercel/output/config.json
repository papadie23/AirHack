{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/location/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/metar/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/population-density/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/save-calibration/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/verify/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/weather/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/weather-provider/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}